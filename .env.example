#############################################
# Peach Boy Environment Variables (example)
#############################################
# Copy this file to .env. Put machine-specific overrides in .env.local (gitignored).

## Public (client-exposed) variables (must be prefixed with VITE_)
# S3-compatible endpoint base (no trailing slash). Can be a CDN origin later.
VITE_AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# Public bucket name containing comic images.
VITE_BUCKET_NAME=peachboy
# App/comic display name (optional; default: Peach Boy)
VITE_APP_NAME=Peach Boy

## Derived in code:
# Public image base constructed as `${VITE_AWS_ENDPOINT_URL_S3}/${VITE_BUCKET_NAME}`

## Server-only secrets (do NOT prefix with VITE_). DO NOT COMMIT real values.
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
# AWS_REGION=auto
# (Optional) CUSTOM_DOMAIN_CDN=https://cdn.example.com

## Optional future public values
# VITE_ANALYTICS_ID=UA-XXXX
# VITE_FEATURE_FLAGS={"altText":true}

## Notes
# - Only VITE_* vars are bundled to the client.
# - Add new public vars to app/env.ts for typed access.
# - Keep secrets out of VITE_ unless you intend them to be public.
